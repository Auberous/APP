# Copy this file to .env and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# EXPO_PUBLIC_ variables are inlined into the app bundle at build time, so they
# are visible to anyone with the app. That is correct for these two: the anon
# key grants no access by itself, because every table's access is decided by
# the Row Level Security policies in supabase/migrations/.
#
# Never put the service-role key in this file or anywhere in the app. It
# bypasses RLS entirely.
#
# After changing these, restart with `npx expo start --clear` — a running dev
# server will not pick up new values.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
