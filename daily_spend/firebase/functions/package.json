{
  "name": "daily-spend-functions",
  "description": "Cloud Functions for Daily Spend: bank webhooks, budget recalculation, and push notifications.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "mocha --ignore 'src/**/*.integration.test.ts' 'src/**/*.test.ts'",
    "test:integration": "firebase emulators:exec --project demo-daily-spend --only firestore --config ../firebase.json \"mocha 'src/**/*.integration.test.ts'\""
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.11",
    "@types/sinon": "^22.0.0",
    "firebase-tools": "^15.30.0",
    "mocha": "^10.7.3",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
